rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // User profiles
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Users may only create their own profile as a plain USER with zero balance.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'USER'
        && request.resource.data.balance == 0;

      // Only admins can change role/balance/active state.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Deposits / withdrawals / investments
    match /transactions/{txId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow update: if isAdmin();
      allow delete: if false;
    }

    // Wallet deposit addresses: public read, admin write
    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
