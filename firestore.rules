rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() && myProfile().role == 'ADMIN';
    }

    // Admins, plus users whose account has been approved (accounts that
    // pre-date the approval feature have no status and count as approved).
    function isApproved() {
      return hasProfile()
        && (myProfile().role == 'ADMIN'
            || myProfile().get('accountStatus', 'APPROVED') == 'APPROVED');
    }

    // User profiles
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Users may only create their own profile as a plain USER, zero balance,
      // and PENDING until an admin approves it.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'USER'
        && request.resource.data.balance == 0
        && request.resource.data.accountStatus == 'PENDING';

      // Only admins can change role/balance/status.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Deposits / withdrawals / investments
    match /transactions/{txId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isApproved()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow update: if isAdmin();
      allow delete: if false;
    }

    // Customer support chat
    match /support_messages/{msgId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // A message needs text, a photo (compressed data URL), or both.
      allow create: if isApproved()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          request.resource.data.text.size() > 0
          || ('imageData' in request.resource.data)
        )
        && (
          !('imageData' in request.resource.data)
          || (request.resource.data.imageData is string
              && request.resource.data.imageData.size() <= 700000
              && request.resource.data.imageData.matches('data:image/.*'))
        )
        && (
          (request.resource.data.userId == request.auth.uid
            && request.resource.data.sender == 'USER')
          || (isAdmin() && request.resource.data.sender == 'ADMIN')
        );

      // Admins can mark anything read; users may only flip their own readByUser flag.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByUser']));

      allow delete: if false;
    }

    // Wallet deposit addresses: public read, admin write
    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
